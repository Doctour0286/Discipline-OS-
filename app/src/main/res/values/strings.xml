        available.
    -->
    <string name="countdown_complete">You can choose now.</string>

    <!--
        Accessibility Service on-device description strings, shown to the user in Android
        Settings > Accessibility when they enable MissionAccessibilityService — NOT the Play
        Console declaration text (that's out of scope for this sideload-only pass, see
        mission_accessibility_service_config.xml's top comment). Plain and specific about
        what the service does and does not do, matching Architecture §1.2's "narrow, clearly
