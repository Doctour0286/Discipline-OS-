<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding doc §4 (Cross-Cutting Copy Review Requirement): "Every user-facing string in
    this document ... should pass the same behavior-vs-identity test from PRD §22.1 before
    ship, not just Warden Voice's AI-generated output." The strings below are static UI copy
    (button labels, countdown text, the Recruit/Operator informational fallback), not
    AI-generated Warden Voice content — VoiceLineGate.kt doesn't run against these at runtime
    since they never pass through WardenVoiceProvider — but they were hand-checked against
    the same §22.1 shape (no "you are/you're a ___" identity framing) before being written
    here, per §4's instruction that this review is systematic, not spot-checked once.

    None of this is final visual copy — Onboarding doc §5 defers visual design/tone polish to
    a follow-on doc. This is a first pass sufficient to make the screen functional and
    spec-compliant in substance, flagged for the same copy-review pass §4 asks for before
    ship, same as everything else in this doc.
-->
<resources>

    <!--
        Onboarding §3.1: "Recruit/Operator: informational, lower-pressure countdown, casual
        exit available." This is the fallback shown when InterceptionPolicy.usesWardenVoice
        is false (voiceLineView.text falls back to this — see renderVoiceLine's kdoc).
        Behavior-focused: describes the Mission and the choice in front of the user, not a
        judgment about who they are for opening a blocked app.
    -->
    <string name="interception_informational_copy">This app is outside your current Mission. You can return to the Mission, or end it early if something\'s changed.</string>

    <!--
        PRD §12.4.4: Iron-tier crisis exit, "reachable from this exact screen ... honored
        immediately: no delay, no additional confirmation screen, no reason entry." Label
        names the mechanism plainly rather than dramatizing it — a crisis exit is a safety
        control, and copy that makes it sound like a bigger deal than "leave now, no
        penalty" would work against the control's own purpose.
    -->
    <string name="iron_crisis_exit_label">Exit Now — No Penalty</string>

    <!--
        PRD §12.4.2: the general "this is too much right now" stability control, shown at
        every tier below Iron on this screen. Kept distinct in wording from the Iron Crisis
        Exit label above (a genuinely different, less acute control — see InterceptionPolicy
        and ROADMAP.md §5.15 for why they're not the same button).
    -->
    <string name="explicit_downgrade_label">This Is Too Much Right Now</string>

    <string name="return_to_mission_label">Return to Mission</string>
    <string name="break_commitment_label">Break Commitment</string>

    <!--
        Iron-only Break Commitment reason field (InterceptionPolicy.requiresBreakCommitmentReason).
        Asks what happened, not what that says about the user — matches the
        behavior-vs-identity framing this doc's §4 requires and mirrors the same "what
        happened" framing §3.2 recommends for the Tribunal's structured review.
    -->
    <string name="break_reason_hint">What happened? (required to break this commitment)</string>

    <!--
        %d = whole seconds remaining, ticked every COUNTDOWN_TICK_MILLIS by
        MissionInterceptionActivity.startCountdown(). Plain numeral display, not a
        countdown-as-threat framing — matches interception_informational_copy's tone.
    -->
    <string name="countdown_seconds_remaining">%d</string>

    <!--
        Shown once CountDownTimer.onFinish() fires and (at Warden/Iron) the decision buttons
        become enabled. Neutral, not celebratory or shaming either direction — the countdown
        completing isn't itself a win or a loss, just the point where a choice becomes
        available.
    -->
    <string name="countdown_complete">You can choose now.</string>

    <!--
        Accessibility Service on-device description strings, shown to the user in Android
        Settings > Accessibility when they enable MissionAccessibilityService — NOT the Play
        Console declaration text (that's out of scope for this sideload-only pass, see
        mission_accessibility_service_config.xml's top comment). Plain and specific about
        what the service does and does not do, matching Architecture §1.2's "narrow, clearly
        justified use case" framing even though there's no store review to satisfy here —
        the same honesty standard applies to what a family member reads before enabling it.
    -->
    <string name="accessibility_service_summary">Lets DisciplineOS detect when you open an app outside your current Mission.</string>
    <string name="accessibility_service_description">DisciplineOS uses this permission only to see which app is in the foreground while a Mission is active, so it can show the interception screen if you open something outside that Mission\'s allowed apps. It does not read screen content, does not log what you type, and does not run when no Mission is active.</string>

    <!--
        ROADMAP.md Phase 3 — OnboardingPlaceholderFragment strings. Not real onboarding copy;
        see that class's kdoc for why placeholder content exists ahead of real screens. Not
        subject to the same §22.1 behavior-vs-identity review as everything above this point in
        the file — this text describes navigation-skeleton scaffolding, not anything the real
        product ships with.
    -->
    <string name="onboarding_placeholder_step_progress">Step %1$d of %2$d</string>
    <string name="onboarding_placeholder_next">Next</string>
    <string name="onboarding_placeholder_back">Back</string>

    <!--
        ROADMAP.md Phase 3 continuation — TierSelectionFragment strings, replacing
        OnboardingPlaceholderFragment at the tierSelectionFragment destination. Checked
        against PRD §22.1's behavior-vs-identity test and Onboarding §2.3's explicit
        anti-pattern ("do not visually code Iron as the real/serious choice and Recruit as
        for beginners/not serious") before being written — descriptions state what each tier
        does, not what kind of person picks it.
    -->
    <string name="tier_selection_step_progress">Step 4 of 8</string>
    <string name="tier_selection_title">Tier Selection</string>
    <string name="tier_selection_intro">Pick where to start. You can move to a stricter tier later — Recruit and Operator adjust immediately, Warden and Iron need a confirmation step.</string>

    <string name="tier_recruit_label">Recruit</string>
    <string name="tier_recruit_description">Lower-pressure enforcement. Casual exits available. A reasonable place to start if you\'re not sure yet.</string>

    <string name="tier_operator_label">Operator</string>
    <string name="tier_operator_description">Stricter blocking during Missions, standard violation feedback. No casual-exit restriction beyond what Recruit already has.</string>

    <string name="tier_warden_label">Warden</string>
    <string name="tier_warden_description">Maximum enforcement, no casual exits once a Mission starts. Direct, evidence-based feedback on violations. Requires confirming on the next screen.</string>

    <!--
        PRD §12.6: "Iron is not selectable at first-time onboarding regardless of stated user
        intent... no exception path." Description states the actual reason (a real
        calibration requirement, not the system doubting the user — matching §2.5's own copy
        requirement: "frame this as protecting the parameters that will govern Iron, not as
        the system doubting the user's commitment") rather than a vague "not available yet."
    -->
    <string name="tier_iron_label">Iron (unlocks after 10 days at Recruit or Operator)</string>
    <string name="tier_iron_description">Same enforcement as Warden, no in-the-moment exit at all. Locked at first setup so its stricter limits are set from your own data, not guessed — available once you\'ve used Recruit or Operator for a while.</string>

    <string name="tier_selection_continue">Continue</string>

    <!--
        PRD §22.1 / Onboarding §4: static confirmation copy, reviewed against the same
        behavior-vs-identity shape as everything else — states what Warden does and what
        confirming means, not a claim about the user\'s resolve or character.
    -->
    <string name="tier_confirmation_title">Confirm Warden</string>
    <string name="tier_confirmation_body">At Warden, Missions have no casual exit once started. Violations get direct, evidence-based feedback — never a judgment about who you are. Confirming starts you at Warden; you can still request a lower tier at any time.</string>
    <string name="tier_confirmation_confirm">Confirm Warden</string>

    <string name="mission_profile_setup_step_progress">Step 5 of 8</string>
    <string name="mission_profile_setup_title">Mission Profile Setup</string>
    <string name="mission_profile_setup_intro">Set up what a Mission allows and blocks. You can create more Profiles or edit this one later — this is just your first.</string>
    <string name="mission_profile_setup_name_label">Profile name</string>
    <string name="mission_profile_setup_name_hint">e.g. Deep Work</string>
    <string name="mission_profile_setup_allowlist_label">Allowed apps</string>
    <string name="mission_profile_setup_allowlist_hint_body">One app per line. Leave blank if you\'d rather define this by what\'s blocked.</string>
    <string name="mission_profile_setup_allowlist_hint">com.example.notes</string>
    <string name="mission_profile_setup_blocklist_label">Blocked apps</string>
    <string name="mission_profile_setup_blocklist_hint_body">One app per line. These are off-limits for the duration of a Mission using this Profile.</string>
    <string name="mission_profile_setup_blocklist_hint">com.example.socialapp</string>
    <string name="mission_profile_setup_empty_ok_note">Both lists are optional here — you can leave them empty and fill them in later.</string>
    <string name="mission_profile_setup_continue">Continue</string>

    <!-- §2.2 Goal Definition. "Link visible" requirement (spec's own phrase) is
         goal_definition_link_note below — must state plainly that these are the *only*
         categories ever looked at outside a Mission, not just imply it. -->
    <string name="goal_definition_step_progress">Step 2 of 8</string>
    <string name="goal_definition_title">What are you protecting time for?</string>
    <string name="goal_definition_intro">Tell us what matters, in your own words, and flag any categories you consider high-value or high-risk. This shapes your first Mission Profile suggestions later.</string>
    <string name="goal_definition_freetext_label">In your own words</string>
    <string name="goal_definition_freetext_hint">e.g. Finishing my thesis without getting pulled into social feeds</string>
    <string name="goal_definition_categories_label">Flag categories (optional)</string>
    <string name="goal_definition_categories_hint_body">One category per line — e.g. \"social media\", \"news\", \"games\". These are just labels you choose; nothing is scanned or inferred automatically.</string>
    <string name="goal_definition_categories_hint">social media</string>
    <string name="goal_definition_link_note">The categories you flag here are the only ones we\'ll ever look at outside your Missions — see Unsupervised Reliability later in setup.</string>
    <string name="goal_definition_continue">Continue</string>

</resources>
