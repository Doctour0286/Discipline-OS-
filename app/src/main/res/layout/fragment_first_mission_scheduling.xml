<?xml version="1.0" encoding="utf-8"?>
<!--
    UNREFERENCED as of the design-system pass (ROADMAP.md — see this commit's entry):
    FirstMissionSchedulingFragment.kt now hosts a Compose screen (FirstMissionSchedulingScreen,
    in ui/onboarding/) via a single ComposeView instead of inflating this file. Left in place
    deliberately rather than deleted in the same pass — cleanup of now-dead XML layouts left
    behind by the Compose migration is being tracked as its own step (see ROADMAP.md's "known
    standing gaps"), so other screens' still-live layouts and this file's history stay easy to
    diff against each other rather than being interleaved with unrelated deletions. Do not
    re-wire this file back in without updating FirstMissionSchedulingFragment.kt's kdoc, which
    documents the Compose migration as the current source of truth for this screen.

    Original content below preserved as-is, for reference only — kept in sync with neither the
    Fragment nor strings.xml going forward.

    Onboarding, Consent & Interaction Spec §2.9 (First Mission Scheduling) — real content,
    replacing OnboardingPlaceholderFragment at the firstMissionSchedulingFragment destination.
    Closes onboarding — see the nav graph's own comment on why this destination declares no
    outgoing <action>.

    §2.9's own text: "schedule vs. start-now choice here is itself the first data point for
    Self-Initiation Trend (Data Model doc §3.6)... even though it's measurement-only and
    doesn't affect this screen's design." Two equally-weighted primary actions below, neither
    styled as the "default" or "recommended" path, for exactly that reason — this screen isn't
    supposed to nudge the user toward either choice, just record which one they actually made.

    A plain time-input field backs "Schedule for later" (see FirstMissionSchedulingFragment's
    kdoc for the input format) rather than a full date/time picker widget — same "plain
    EditText over a native picker" precedent MissionProfileSetupFragment's layout already set
    for its own free-text allow/blocklist fields, kept here for the same reason: no spec
    requirement forces a richer widget, and a picker dependency isn't worth introducing for a
    single field this early.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/first_mission_scheduling_step_progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="@string/first_mission_scheduling_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="15sp"
            android:text="@string/first_mission_scheduling_intro_body" />

        <Button
            android:id="@+id/firstMissionSchedulingStartNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/first_mission_scheduling_start_now_button" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/darker_gray" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/first_mission_scheduling_schedule_label" />

        <EditText
            android:id="@+id/firstMissionSchedulingTimeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:inputType="datetime"
            android:hint="@string/first_mission_scheduling_schedule_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/first_mission_scheduling_schedule_format_note" />

        <Button
            android:id="@+id/firstMissionSchedulingScheduleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/first_mission_scheduling_schedule_button" />

        <Button
            android:id="@+id/firstMissionSchedulingBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_placeholder_back" />

    </LinearLayout>

</ScrollView>
