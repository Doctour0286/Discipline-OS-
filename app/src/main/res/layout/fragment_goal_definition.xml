<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding, Consent & Interaction Spec §2.2 (Goal Definition) — real content, replacing
    OnboardingPlaceholderFragment at this destination.

    Two inputs per spec: free-text (what the user is protecting time for) and structured tags
    for "high-value"/"high-risk" categories. Categories use the same one-per-line plain
    EditText convention as MissionProfileSetupFragment's allowlist/blocklist (see that
    layout's own comment for why — no installed-app/category picker UI exists anywhere in
    this project yet), rather than a chip/tag-input widget that would be new UI machinery for
    this one screen alone.

    §2.2's "interaction detail" requirement — "the UI should make that link visible" between
    what's flagged here and §2.7's Unsupervised Reliability scope — is goal_definition_link_note
    below, a persistent visible line, not a tooltip or a dialog the user could miss.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/goal_definition_step_progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="@string/goal_definition_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textSize="14sp"
            android:text="@string/goal_definition_intro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/goal_definition_freetext_label" />

        <EditText
            android:id="@+id/goalDefinitionFreetextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="20dp"
            android:inputType="textMultiLine"
            android:hint="@string/goal_definition_freetext_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/goal_definition_categories_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/goal_definition_categories_hint_body" />

        <EditText
            android:id="@+id/goalDefinitionCategoriesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="16dp"
            android:inputType="textMultiLine"
            android:hint="@string/goal_definition_categories_hint" />

        <!--
            §2.2's "interaction detail" requirement, verbatim from the spec: make the link to
            §2.7 (Unsupervised Reliability scope) visible here, not just assumed. Deliberately
            styled the same as MissionProfileSetupFragment's "empty is OK" note (small, gray,
            informational) rather than a warning color — this is a reassurance about scope
            limits, not a caution about a risky action.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/goal_definition_link_note" />

        <Button
            android:id="@+id/goalDefinitionContinueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goal_definition_continue" />

        <Button
            android:id="@+id/goalDefinitionBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/onboarding_placeholder_back" />

    </LinearLayout>

</ScrollView>
