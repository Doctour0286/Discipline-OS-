<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding, Consent & Interaction Spec §2.3 (Tier Explanation) — real content, replacing
    OnboardingPlaceholderFragment at the tierExplanationFragment destination.

    §2.3's own requirement, verbatim: "all four tiers shown side by side, not sequentially
    revealed — a user should be able to compare before committing, not be funneled tier-by
    -tier toward the most severe option." A single vertical list (this project's usual layout
    convention, used by fragment_tier_selection.xml) reads as sequential, one tier at a time —
    the opposite of what "side by side" asks for. A HorizontalScrollView of four equal-width
    cards is the standard mobile pattern for genuine side-by-side comparison without either
    cramming four full paragraphs onto one screen at unreadable size or falling back to a
    vertical list that recreates the sequential-funnel problem this screen exists to avoid.

    Every card below shares one identical structural template — same label position, same
    section order (enforcement, then voice, then exit), same text sizes, same spacing, no
    per-tier color/weight/icon treatment — enforcing §2.3's explicit anti-pattern requirement
    structurally (a shared template can't accidentally visually code one tier as "the serious
    choice") rather than relying on each card being manually kept consistent with the others.
    Recruit is positioned first only because Onboarding §1 / PRD §12.6 describe the tiers in
    Recruit->Iron order — see strings.xml's tier_explanation block comment for the full
    anti-pattern reasoning.

    No RadioButton/selection UI here — that's Tier Selection's (§2.4) job, one screen later.
    This screen is read-only comparison; Continue always advances to Tier Selection regardless
    of which card(s) the user scrolled through, matching how TierExplanation has no User-row
    interaction at all (nothing to persist, nothing to guard against re-entry on).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/tier_explanation_step_progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="@string/tier_explanation_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="@string/tier_explanation_intro" />

    </LinearLayout>

    <!--
        Fixed-height comparison strip: HorizontalScrollView so all four cards are reachable by
        swiping side to side (§2.3's "side by side" requirement) inside a fixed vertical
        footprint, rather than the whole screen scrolling vertically and burying later tiers
        below the fold the way a plain vertical list would. wrap_content height lets each
        card's own content (four sub-sections of varying length, Iron's exit text being the
        longest) determine the strip's height without hardcoding a number that would either
        clip Iron's text or waste space under the shorter cards.
    -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Recruit -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="16dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="@string/tier_explanation_recruit_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_enforcement" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_recruit_enforcement" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_voice" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_recruit_voice" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_exit" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_recruit_exit" />

            </LinearLayout>

            <!-- Operator -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="16dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="@string/tier_explanation_operator_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_enforcement" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_operator_enforcement" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_voice" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_operator_voice" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_exit" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_operator_exit" />

            </LinearLayout>

            <!-- Warden -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="16dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="@string/tier_explanation_warden_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_enforcement" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_warden_enforcement" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_voice" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_warden_voice" />

                <!--
                    §2.3: "be explicit about Warden/Iron's no-casual-exit design — this is the
                    single most important disclosure in the whole flow." No different visual
                    treatment (no bold/red/larger text) versus the other three cards' exit
                    sections — the disclosure's weight comes from its own wording, which
                    states the no-casual-exit fact plainly, not from a color or size cue that
                    would break this screen's identical-template rule.
                -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_exit" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_warden_exit" />

            </LinearLayout>

            <!-- Iron -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="@string/tier_explanation_iron_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_enforcement" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_iron_enforcement" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_voice" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_iron_voice" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/darker_gray"
                    android:text="@string/tier_explanation_section_exit" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/tier_explanation_iron_exit" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/tierExplanationContinueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tier_explanation_continue" />

        <Button
            android:id="@+id/tierExplanationBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/onboarding_placeholder_back" />

    </LinearLayout>

</LinearLayout>
