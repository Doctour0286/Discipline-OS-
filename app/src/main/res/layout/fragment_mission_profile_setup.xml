<?xml version="1.0" encoding="utf-8"?>
<!--
    UNREFERENCED as of the onboarding-wide Compose migration (ROADMAP.md §5.26 — see this
    commit's entry): MissionProfileSetupFragment now hosts a Compose screen (MissionProfileSetupScreen, in
    ui/onboarding/) via a single ComposeView instead of inflating this file. Left in place
    deliberately rather than deleted in the same pass — cleanup of now-dead XML layouts left
    behind by the Compose migration is being tracked as its own step (see
    fragment_first_mission_scheduling.xml, marked the same way in the prior Compose-migration
    PR), so other screens' still-live layouts and this file's history stay easy to diff
    against each other rather than being interleaved with unrelated deletions. Do not re-wire
    this file back in without updating MissionProfileSetupFragment.kt's kdoc, which documents the Compose
    migration as the current source of truth for this screen.

    Original content below preserved as-is, for reference only — kept in sync with neither the
    Fragment nor strings.xml going forward.
-->

<!--
    Onboarding, Consent & Interaction Spec §2.8 (Mission Profile Setup) — real content,
    replacing OnboardingPlaceholderFragment at this one destination.

    §2.8's only content requirement is: "should default to suggestions drawn from §2.2's
    flagged categories rather than a blank list, to reduce first-session abandonment." That
    dependency does not exist yet — Goal Definition (§2.2, step 2 of this same flow) is still
    OnboardingPlaceholderFragment content, so there is no flagged-category data anywhere to
    default from. Rather than inventing a plausible-looking default list (which would be
    exactly the kind of silently-resolved gap this project's own conventions argue against —
    see ROADMAP.md §0's "if you're about to invent a... plausible-sounding default the spec
    doesn't give you, stop" instruction), this screen ships with empty free-text fields and
    the dependency gap logged in ROADMAP.md §5. Revisit once Goal Definition has real content
    to draw suggestions from.

    Two plain multi-line text fields (allowlist, blocklist) rather than a package picker —
    matching Mission/MissionProfile's own package-id-as-string schema convention (see
    MissionProfile.kt kdoc), and there is no installed-app enumeration UI anywhere in this
    project yet to build a picker against. One package id per line; parsed in the Fragment.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/mission_profile_setup_step_progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="@string/mission_profile_setup_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textSize="14sp"
            android:text="@string/mission_profile_setup_intro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/mission_profile_setup_name_label" />

        <EditText
            android:id="@+id/missionProfileNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:inputType="text"
            android:hint="@string/mission_profile_setup_name_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/mission_profile_setup_allowlist_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/mission_profile_setup_allowlist_hint_body" />

        <EditText
            android:id="@+id/missionProfileAllowlistInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="20dp"
            android:inputType="textMultiLine"
            android:hint="@string/mission_profile_setup_allowlist_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/mission_profile_setup_blocklist_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/mission_profile_setup_blocklist_hint_body" />

        <EditText
            android:id="@+id/missionProfileBlocklistInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="8dp"
            android:inputType="textMultiLine"
            android:hint="@string/mission_profile_setup_blocklist_hint" />

        <!--
            §2.8 doesn't require a validation gate here, and no other onboarding screen in
            this project blocks progress on empty input (Tier Selection has a mandatory
            default-checked RadioButton instead — a different shape of "can't submit
            nothing"). A user who skips both fields entirely gets a Mission Profile with two
            empty lists, which is a legitimate (if useless) starting state, not an error —
            they can always edit it later once a profile-editing UI exists. Flagged, not
            silently gated behind an invented validation rule the spec doesn't ask for.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:text="@string/mission_profile_setup_empty_ok_note" />

        <Button
            android:id="@+id/missionProfileSetupContinueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mission_profile_setup_continue" />

        <Button
            android:id="@+id/missionProfileSetupBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/onboarding_placeholder_back" />

    </LinearLayout>

</ScrollView>
