<?xml version="1.0" encoding="utf-8"?>
<!--
    MainActivity's content view — a single NavHostFragment container running
    res/navigation/onboarding_nav_graph.xml. ROADMAP.md Phase 3 navigation skeleton; see
    MainActivity.kt's kdoc for what the graph now covers (onboarding's nine screens, plus the
    post-onboarding Home / Iron Calibration destinations added in a later pass — see that
    kdoc's own "Corrected, this pass" note before trusting an older description of this file).
-->
<androidx.fragment.app.FragmentContainerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navHostFragmentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:name="androidx.navigation.fragment.NavHostFragment"
    app:navGraph="@navigation/onboarding_nav_graph"
    app:defaultNavHost="true" />
