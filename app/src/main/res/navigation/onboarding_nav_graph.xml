<?xml version="1.0" encoding="utf-8"?>
<!--
    Enforcer-stripped navigation graph.
    Onboarding, Home, MissionDetail screens moved to web-app-reference/.
    The Enforcer's primary UI is MissionInterceptionActivity (not in this graph).
    This graph exists only so MainActivity's NavHostFragment has a valid start destination.
    Replace with real Console-initiated screens once Prompt 4 adds them.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_nav_graph"
    app:startDestination="@id/enforcerPlaceholderFragment">

    <!--
        Minimal placeholder — the Enforcer has no onboarding flow.
        The Accessibility Service is enabled via system settings, not in-app navigation.
        This fragment just tells the user what the Enforcer is for.
    -->
    <fragment
        android:id="@+id/enforcerPlaceholderFragment"
        android:name="com.disciplineos.app.ui.enforcer.EnforcerPlaceholderFragment"
        android:label="DisciplineOS Enforcer" />
</navigation>
